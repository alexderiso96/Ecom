# ==============================================================================
# CONFIGURAZIONE ENVIRONMENT - E-COMMERCE CON DROPSHIPPING ALIEXPRESS
# ==============================================================================

# 1. Supabase Public Configuration (Accessibili da Client & Server)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# 2. Supabase Service Role Key (SERVER-SIDE ONLY - Non esporre mai al client!)
# Necessaria per operazioni admin, tabella aliexpress_credentials e sync job
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# 3. Cron & API Protection Secret (Condiviso con GitHub Actions Scheduled Workflows)
# Genera una stringa casuale lunga (es. openssl rand -hex 32)
CRON_SECRET=your-random-cron-secret-token-32-chars

# 4. WhatsApp Direct Support & Checkout
NEXT_PUBLIC_WHATSAPP_NUMBER=393331234567

# 5. AliExpress Open Platform Credentials (Opzionali se configurati nella tabella Supabase aliexpress_credentials)
ALIEXPRESS_APP_KEY=your-aliexpress-app-key
ALIEXPRESS_APP_SECRET=your-aliexpress-app-secret
ALIEXPRESS_ACCESS_TOKEN=your-aliexpress-access-token
ALIEXPRESS_REFRESH_TOKEN=your-aliexpress-refresh-token
ALIEXPRESS_EXPIRES_AT=2026-12-31T23:59:59Z

# 6. Public App URL (Usato per webhooks o nei GitHub Repository Secrets)
# In produzione su Vercel: https://tuo-dominio.vercel.app
APP_URL=https://your-app-domain.vercel.app
