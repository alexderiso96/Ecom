# Supabase Public Configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# WhatsApp Checkout Configuration (International format without '+' e.g. 393331234567)
NEXT_PUBLIC_WHATSAPP_NUMBER=393331234567

# Required for checkout. Server-side only. Never prefix with NEXT_PUBLIC.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Optional Cloudinary storage. Configure the three credentials together.
# Keep these values server-side. Do not prefix them with NEXT_PUBLIC_.
# CLOUDINARY_CLOUD_NAME=your-cloud-name
# CLOUDINARY_API_KEY=your-api-key
# CLOUDINARY_API_SECRET=your-api-secret
# CLOUDINARY_UPLOAD_PRESET=dream_creation_products
