# Supabase Public Configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# WhatsApp Checkout Configuration (International format without '+' e.g. 393331234567)
NEXT_PUBLIC_WHATSAPP_NUMBER=393331234567

# Optional: Supabase Service Role Key (ONLY for server-side elevated scripts if needed, never expose to client)
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

