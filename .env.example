# Supabase Public Configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Supabase Service Role Key (richiesta lato server per bypassare RLS su cj_credentials e webhook)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# WhatsApp Checkout Configuration (formato internazionale senza '+', es. 393331234567)
NEXT_PUBLIC_WHATSAPP_NUMBER=393331234567

# CJdropshipping API v2.0 Configuration
CJ_EMAIL=your-cj-email@example.com
CJ_API_KEY=your-cj-api-key
# In alternativa all'API key, se usi password account:
# CJ_PASSWORD=your-cj-account-password
# openId restituito dopo l'autenticazione CJ (usato come secret HMAC per la verifica dei webhook)
CJ_OPEN_ID=your-cj-open-id

# Modalità Sandbox CJdropshipping (true per test, false per ordini reali con spedizione fisica)
CJ_SANDBOX=true

# Codice paese magazzino di partenza (default "CN" per Cina, "IT" o "DE" per magazzini europei)
CJ_START_COUNTRY_CODE=CN

# Corriere predefinito se non selezionato
CJ_DEFAULT_LOGISTIC="CJ Packet Ordinary"

# Configurazione IOSS UE (1 = IOSS CJ platform, 2 = IOSS proprio)
CJ_IOSS_TYPE=1

# Secret per proteggere gli endpoint di sincronizzazione schedulati (GitHub Actions o Cron)
CRON_SECRET=your-secure-random-cron-secret
